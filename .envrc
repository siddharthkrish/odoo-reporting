# Give this repo its own gcloud credential store.
#
# The gcloud CLI's active account/project and Application Default Credentials
# otherwise live in shared user-level state. Switching GCP projects can then
# surface as misleading 403s from an unexpected account. CLOUDSDK_CONFIG keeps
# both forms of credentials isolated for this repo.
#
# Requires direnv and a one-time `direnv allow` in this directory.
export CLOUDSDK_CONFIG="$HOME/.gcloud/odoo-reporting"
